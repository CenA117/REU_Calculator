<Window x:Class="ZeleninCalculatorApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:infra="clr-namespace:ZeleninCalculatorApp.Infrastructure"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="700"
        Width="1020"
        MinHeight="560"
        MinWidth="860"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        PreviewTextInput="OnPreviewTextInput"
        PreviewKeyDown="OnPreviewKeyDown">

    <Window.Resources>

        <infra:StringToBrushConverter x:Key="B"/>

        <!-- Кнопка с мягким скруглением и анимацией нажатия -->
        <ControlTemplate x:Key="AnimatedButtonTemplate" TargetType="Button">
            <Border x:Name="RootBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="12"
                    RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Border.RenderTransform>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RootBorder" Property="Opacity" Value="0.86"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="RootBorder" Property="Opacity" Value="0.7"/>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="0.96" Duration="0:0:0.06">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="0.96" Duration="0:0:0.06">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 To="1" Duration="0:0:0.1">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="RootBorder"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 To="1" Duration="0:0:0.1">
                                    <DoubleAnimation.EasingFunction>
                                        <QuadraticEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="RootBorder" Property="Opacity" Value="0.45"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Цифры и точка -->
        <Style x:Key="NumButtonStyle" TargetType="Button">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{Binding KeyBorderBrush, Converter={StaticResource B}}"/>
            <Setter Property="Background" Value="{Binding KeyBackground, Converter={StaticResource B}}"/>
            <Setter Property="Foreground" Value="{Binding KeyForeground, Converter={StaticResource B}}"/>
            <Setter Property="Template" Value="{StaticResource AnimatedButtonTemplate}"/>
        </Style>

        <!-- Служебные: скобки, CE, C, xʸ, ⌫ -->
        <Style x:Key="FuncButtonStyle" TargetType="Button" BasedOn="{StaticResource NumButtonStyle}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{Binding SecondaryText, Converter={StaticResource B}}"/>
        </Style>

        <!-- Операторы: ÷ × − + -->
        <Style x:Key="OpButtonStyle" TargetType="Button" BasedOn="{StaticResource NumButtonStyle}">
            <Setter Property="Background" Value="{Binding AccentKeyBackground, Converter={StaticResource B}}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{Binding AccentKeyForeground, Converter={StaticResource B}}"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Равно -->
        <Style x:Key="EqualButtonStyle" TargetType="Button" BasedOn="{StaticResource OpButtonStyle}">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <!-- Кнопки тулбара -->
        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource NumButtonStyle}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="{Binding KeyBorderBrush, Converter={StaticResource B}}"/>
            <Setter Property="Background" Value="{Binding PanelBackground, Converter={StaticResource B}}"/>
        </Style>

    </Window.Resources>

    <Border Background="{Binding PageBackground, Converter={StaticResource B}}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Левая колонка: шапка, дисплей, клавиатура -->
            <Grid Grid.Column="0" Margin="20,16,12,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="160"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="42" Height="42"
                            CornerRadius="13"
                            Background="{Binding AccentKeyBackground, Converter={StaticResource B}}"
                            VerticalAlignment="Center">
                        <Border.Effect>
                            <DropShadowEffect Color="#5B7CFA" BlurRadius="18" ShadowDepth="0" Opacity="0.45"/>
                        </Border.Effect>
                        <TextBlock Text="Z"
                                   Foreground="{Binding AccentKeyForeground, Converter={StaticResource B}}"
                                   FontSize="21"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WindowTitle}"
                                   Foreground="{Binding KeyForeground, Converter={StaticResource B}}"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding AuthorText}"
                                   Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                                   FontSize="11"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource ToolButtonStyle}"
                                Command="{Binding ToggleLanguageCommand}"
                                Content="{Binding LanguageButtonText}"
                                Margin="0,0,6,0"/>
                        <Button Style="{StaticResource ToolButtonStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                Content="{Binding ThemeButtonText}"/>
                    </StackPanel>
                </Grid>

                <!-- Дисплей -->
                <Border Grid.Row="1"
                        CornerRadius="16"
                        BorderThickness="1"
                        BorderBrush="{Binding KeyBorderBrush, Converter={StaticResource B}}"
                        Background="{Binding PanelBackground, Converter={StaticResource B}}">
                    <Grid Margin="22,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding ExpressionLabelText}"
                                   Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Opacity="0.8"/>

                        <TextBox Grid.Row="1"
                                 Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                                 FontSize="22"
                                 HorizontalContentAlignment="Right"
                                 Margin="0,2,0,0"/>

                        <TextBlock Grid.Row="3"
                                   Text="{Binding ResultLabelText}"
                                   Foreground="{Binding SecondaryText, Converter={StaticResource B}}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Opacity="0.8"/>

                        <TextBox Grid.Row="4"
                                 Text="{Binding ResultText}"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{Binding KeyForeground, Converter={StaticResource B}}"
                                 FontSize="42"
                                 FontWeight="SemiBold"
                                 HorizontalContentAlignment="Right"
                                 Margin="0,0,0,2"/>
                    </Grid>
                </Border>

                <!-- Клавиатура -->
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Строка 0: скобки + очистка -->
                    <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FuncButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="(" Content="(" Margin="4"/>
                    <Button Grid.Row="0" Grid.Column="1" Style="{StaticResource FuncButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter=")" Content=")" Margin="4"/>
                    <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource FuncButtonStyle}"
                            Command="{Binding ClearEntryCommand}" Content="CE" Margin="4"/>
                    <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource FuncButtonStyle}"
                            Command="{Binding ClearAllCommand}" Content="C" Margin="4"/>

                    <!-- Строка 1: степень, backspace, деление, умножение -->
                    <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FuncButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="^" Content="xʸ" Margin="4"/>
                    <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FuncButtonStyle}"
                            Command="{Binding BackspaceCommand}" Content="←" FontSize="18" Margin="4"/>
                    <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource OpButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="/" Content="÷" Margin="4"/>
                    <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource OpButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="*" Content="×" Margin="4"/>

                    <!-- Строка 2 -->
                    <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="7" Content="7" Margin="4"/>
                    <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="8" Content="8" Margin="4"/>
                    <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="9" Content="9" Margin="4"/>
                    <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource OpButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="-" Content="−" Margin="4"/>

                    <!-- Строка 3 -->
                    <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="4" Content="4" Margin="4"/>
                    <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="5" Content="5" Margin="4"/>
                    <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="6" Content="6" Margin="4"/>
                    <Button Grid.Row="3" Grid.Column="3" Style="{StaticResource OpButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="+" Content="+" Margin="4"/>

                    <!-- Строка 4 -->
                    <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="1" Content="1" Margin="4"/>
                    <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="2" Content="2" Margin="4"/>
                    <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="3" Content="3" Margin="4"/>
                    <Button Grid.Row="4" Grid.Column="3" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="." Content="." Margin="4"/>

                    <!-- Строка 5 -->
                    <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource NumButtonStyle}"
                            Command="{Binding AppendCommand}" CommandParameter="0" Content="0" Margin="4"
                            Grid.ColumnSpan="2"/>
                    <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource EqualButtonStyle}"
                            Command="{Binding EvaluateCommand}" Content="=" Margin="4"
                            Grid.ColumnSpan="2"/>
                </Grid>
            </Grid>

            <!-- Правая колонка: история -->
            <Border Grid.Column="1"
                    Margin="0,16,18,20"
                    CornerRadius="16"
                    BorderThickness="1"
                    BorderBrush="{Binding KeyBorderBrush, Converter={StaticResource B}}"
                    Background="{Binding PanelBackground, Converter={StaticResource B}}">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Border Width="8" Height="8" CornerRadius="4"
                                VerticalAlignment="Center"
                                Background="{Binding AccentKeyBackground, Converter={StaticResource B}}"/>
                        <TextBlock Text="{Binding HistoryTitleText}"
                                   Foreground="{Binding KeyForeground, Converter={StaticResource B}}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="8,0,0,0"/>
                    </StackPanel>

                    <Button Grid.Row="1"
                            HorizontalAlignment="Stretch"
                            Style="{StaticResource FuncButtonStyle}"
                            Command="{Binding ClearHistoryCommand}"
                            Content="{Binding ClearHistoryText}"
                            FontSize="11"
                            Height="28"
                            Margin="0,0,0,10"/>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding HistoryItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,4"
                                            CornerRadius="10"
                                            Padding="10,8"
                                            Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background"
                                                                Value="{Binding DataContext.KeyBackground,
                                                                RelativeSource={RelativeSource AncestorType=ItemsControl},
                                                                Converter={StaticResource B}}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.UseHistoryCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}"/>
                                        </Border.InputBindings>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Expression}"
                                                       Foreground="{Binding DataContext.SecondaryText,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Result}"
                                                       Foreground="{Binding DataContext.KeyForeground,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="19"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Timestamp}"
                                                       Foreground="{Binding DataContext.SecondaryText,
                                                       RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                       FontSize="10"
                                                       Opacity="0.75"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
